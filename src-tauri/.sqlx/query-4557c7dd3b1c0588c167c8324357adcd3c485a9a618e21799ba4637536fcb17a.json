  "query": "\n        SELECT id, created_at, updated_at, cwd, shell, cols, rows, exit_code, title, env_json, scrollback_limit\n        FROM sessions\n        WHERE (? IS NULL OR cwd LIKE ?)\n          AND (? IS NULL OR updated_at >= ?)\n          AND (? IS NULL OR updated_at <= ?)\n          AND (? = 0 OR exit_code IS NOT NULL)\n        ORDER BY updated_at DESC\n        LIMIT ? OFFSET ?\n        ",
